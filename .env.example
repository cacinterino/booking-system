# Local development stack. Copy to .env and adjust if needed; compose works without it too.
# Never commit a real .env file.

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking

# Signing key for local JWTs. Generate a new one for any shared environment:
#   openssl rand -base64 48
JWT_KEY=local-dev-only-key-change-me-at-least-32-characters
JWT_ISSUER=Booking.Api
JWT_AUDIENCE=Booking.Client

ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:5000

# Set to false to start with an empty database.
SEED_DEMO=true
